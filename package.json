{
  "name": "aiodma",
  "version": "15.0.0",
  "description": "AIODMA: Enterprise Multi-Tenant AI Ordering, Dining & KDS Architecture with Gemini 3.7 Flash Sommelier",
  "main": "server.js",
  "scripts": {
    "start": "node src/server/start.js",
    "start:legacy": "node server.js",
    "test": "node tests/run_all_tests.js",
    "dev": "node scripts/dev-v18.cjs",
    "dev:legacy": "node --watch server.js",
    "build": "node scripts/build-v18.cjs",
    "start:v18": "node src/server/start.js",
    "dev:v18": "node scripts/dev-v18.cjs",
    "migrate": "node scripts/migrate.cjs",
    "provision:v18": "node scripts/provision-v18.cjs",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.cjs",
    "test:baseline": "node scripts/capture-baseline.cjs",
    "test:customer": "node tests/e2e/customer-v18.cjs",
    "test:customer:live": "node tests/e2e/customer-live-v18.cjs"
  },
  "keywords": [
    "aiodma",
    "multi-tenant",
    "restaurant-pos",
    "kds",
    "ai-sommelier",
    "gemini",
    "apple-hig",
    "pwa"
  ],
  "author": "AIODMA Core Engineering",
  "license": "MIT",
  "dependencies": {
    "body-parser": "^2.3.0",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.6",
    "decimal.js": "10.6.0",
    "express": "^5.2.1",
    "helmet": "8.3.0",
    "otpauth": "9.5.2",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "embedded-postgres": "18.4.0-beta.17",
    "puppeteer": "^25.8.0"
  }
}
